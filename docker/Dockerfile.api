FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src/procurelens/__init__.py ./src/procurelens/__init__.py
RUN pip install --no-cache-dir ".[ml,agent]"
COPY src ./src
COPY config ./config
ENV PYTHONPATH=/app/src
EXPOSE 8000
CMD ["uvicorn", "procurelens.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
