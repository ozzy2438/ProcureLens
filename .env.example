# --- Database ---
DATABASE_URL=postgresql+psycopg2://procurelens:procurelens@localhost:5433/procurelens
POSTGRES_PASSWORD=procurelens
AGENT_DB_PASSWORD=change-me
POSTGRES_PORT=5433

# --- LLM ---
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- MLflow ---
MLFLOW_TRACKING_URI=http://127.0.0.1:5050
MLFLOW_PORT=5050
AMENDMENT_FEATURE_TABLE=analytics_marts.fct_contracts
CAPABILITY_PROFILE_PATH=config/capability_profile.yml

# --- Bid Intelligence Agent ---
MODEL_SERVICE_URL=http://127.0.0.1:8000
API_PORT=8000
UI_PORT=8501
AGENT_DATABASE_URL=postgresql+psycopg2://agent_readonly:change-me@localhost:5433/procurelens
RAG_CORPUS_PATH=config/rag_corpus.json
AGENT_SQL_SCHEMAS=analytics_marts
AGENT_SQL_MAX_ROWS=200
AGENT_SQL_TIMEOUT_MS=5000

# --- Observability (optional) ---
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_RELEASE=local
LLM_INPUT_COST_PER_1K=0.0
LLM_OUTPUT_COST_PER_1K=0.0

# --- App ---
ENV=demo
RELEASE_VERSION=1.0.0
SNAPSHOT_VERSION=1.0.0
AUDIT_LOG_PATH=logs/audit.jsonl
